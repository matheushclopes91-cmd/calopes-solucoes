# OANDA Configuration
OANDA_MODE=practice
OANDA_TOKEN=your_oanda_api_token_here
OANDA_ACCOUNT=your_oanda_account_id_here

# Database Configuration
DB_USER=forex
DB_PASSWORD=your_secure_password_here

# Redis Cache
